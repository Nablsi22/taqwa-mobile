# Line-ending stability across Windows / macOS / Codemagic.
# Auto-detect text files and normalize them to LF in the repo AND on checkout,
# so the working tree is byte-identical on every platform.
* text=auto eol=lf

# --- Files that MUST keep CRLF (Windows-only scripts) ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# --- Files that MUST keep LF (Unix scripts / Gradle wrapper) ---
*.sh        text eol=lf
gradlew     text eol=lf

# --- Binary assets: no EOL conversion, no text diff ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.svg    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.jks    binary
*.so     binary
*.dylib  binary
*.a      binary
*.zip    binary
*.pdf    binary
